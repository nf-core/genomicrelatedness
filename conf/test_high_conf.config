/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/genomicrelatedness -profile test_high_conf,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile with high confidence variant set'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = params.pipelines_testdata_base_path + params.pipelines_testdata_genomicrelatedness_path_suffix + 'samplesheet/samplesheet.csv'
    fasta  = params.pipelines_testdata_base_path + params.pipelines_testdata_rnaseq_path_suffix + 'reference/genome.fasta.gz'
    known_variants_vcf = params.pipelines_testdata_base_path + params.pipelines_testdata_genomicrelatedness_path_suffix + 'data/high_conf.vcf.gz'
    target_number_of_interval_files = 2
    skip_relatedness_estimation = true
}
