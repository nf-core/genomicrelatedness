/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/genomicrelatedness Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input = null

    // Reference genome options
    fasta                            = null
    dict                             = null
    fasta_fai                        = null
    bwamem2_index                    = null
    intervals                        = null
    target_number_of_interval_files  = 100
    max_number_of_intervals_per_file = 100

    // Variant set options
    known_variants_vcf   = null
    known_variants_tbi   = null
    bootstrapping_rounds = null
    exclude_scaffolds    = null
    include_scaffolds    = null

    // Stages of the pipeline to run
    hard_filter_variants        = false
    skip_bqsr                   = false
    skip_variant_calling        = false
    skip_intersection_thinning  = false
    skip_relatedness_estimation = false

    // MultiQC options
    multiqc_config              = null
    multiqc_title               = null
    multiqc_logo                = null
    max_multiqc_email_size      = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Test data options
    pipelines_testdata_base_path                      = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    pipelines_testdata_genomicrelatedness_path_suffix = 'refs/heads/genomicrelatedness/'
    pipelines_testdata_rnaseq_path_suffix             = 'refs/heads/rnaseq/'

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    local { includeConfig 'conf/local.config' }

    test_full      { includeConfig 'conf/test_full.config'      }
    test           { includeConfig 'conf/test.config'           }
    test_default   { includeConfig 'conf/test_default.config'   }
    test_high_conf { includeConfig 'conf/test_high_conf.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load nf-core/genomicrelatedness custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'


// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/genomicrelatedness'
    contributors    = [
        [
            name: 'Thomas Isensee',
            affiliation: 'Scientific Software Center, Interdisciplinary Center for Scientific Computing (IWR), Heidelberg University, Heidelberg, Germany',
            email: 'thomas.isensee@iwr.uni-heidelberg.de',
            github: 'https://github.com/thomasisensee',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0002-7242-4529'
        ],
        [
            name: 'Gisela H. Kopp',
            affiliation: 'Department for the Ecology of Animal Societies, Max Planck Institute of Animal Behavior & University of Konstanz, Konstanz, Germany',
            email: 'gisela.kopp@uni-konstanz.de',
            github: 'https://github.com/GiselaHKopp',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0001-8396-3264'
        ]
    ]
    homePage        = 'https://github.com/nf-core/genomicrelatedness'
    description     = """A workflow for lcWGS genotype likelihood calling and relatedness estimation"""
    mainScript      = 'main.nf'
    defaultBranch   = 'dev'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
    diagram         = 'docs/images/nf-core-genomicrelatedness-metro-map.png'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes","igenomes_base"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Module specific config files
includeConfig 'conf/modules/angsd_ngsrelate.config'
includeConfig 'conf/modules/bcftools_call.config'
includeConfig 'conf/modules/bcftools_concat.config'
includeConfig 'conf/modules/bcftools_index.config'
includeConfig 'conf/modules/bcftools_isec.config'
includeConfig 'conf/modules/bcftools_mpileup.config'
includeConfig 'conf/modules/bcftools_query.config'
includeConfig 'conf/modules/bcftools_sort.config'
includeConfig 'conf/modules/bcftools_stats.config'
includeConfig 'conf/modules/build_intervals.config'
includeConfig 'conf/modules/bwamem2_mem.config'
includeConfig 'conf/modules/fastp.config'
includeConfig 'conf/modules/gatk4_addorreplacereadgroups.config'
includeConfig 'conf/modules/gatk4_analyzecovariates.config'
includeConfig 'conf/modules/gatk4_applybqsr.config'
includeConfig 'conf/modules/gatk4_baserecalibrator.config'
includeConfig 'conf/modules/gatk4_gatherbqsrreports.config'
includeConfig 'conf/modules/gatk4_genomicsdbimport.config'
includeConfig 'conf/modules/gatk4_genotypegvcfs.config'
includeConfig 'conf/modules/gatk4_haplotypecaller.config'
includeConfig 'conf/modules/gatk4_mergevcfs.config'
includeConfig 'conf/modules/gatk4_markduplicates.config'
includeConfig 'conf/modules/gatk4_selectvariants.config'
includeConfig 'conf/modules/gatk4_variantfiltration.config'
includeConfig 'conf/modules/gunzip.config'
includeConfig 'conf/modules/make_scaffold_bed.config'
includeConfig 'conf/modules/normalize_bam_names.config'
includeConfig 'conf/modules/mosdepth.config'
includeConfig 'conf/modules/preseq_ccurve.config'
includeConfig 'conf/modules/preseq_lcextrap.config'
includeConfig 'conf/modules/samtools_convert.config'
includeConfig 'conf/modules/samtools_index.config'
includeConfig 'conf/modules/samtools_merge.config'
includeConfig 'conf/modules/samtools_stats.config'
includeConfig 'conf/modules/splitintervals.config'
includeConfig 'conf/modules/spring.config'
includeConfig 'conf/modules/vcftools.config'

// Subworkflow specific config files
includeConfig 'conf/subworkflows/base_quality_score_recalibration.config'
includeConfig 'conf/subworkflows/bootstrap_variant_set.config'
includeConfig 'conf/subworkflows/cram_baserecalibrator.config'
includeConfig 'conf/subworkflows/filter_variants.config'
includeConfig 'conf/subworkflows/prepare_genome.config'
includeConfig 'conf/subworkflows/prepare_intervals.config'
includeConfig 'conf/subworkflows/relatedness_estimation.config'
includeConfig 'conf/subworkflows/variant_calling.config'
