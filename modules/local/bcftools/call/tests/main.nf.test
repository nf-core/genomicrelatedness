nextflow_process {

    name "Test Process BCFTOOLS_CALL"
    script "../main.nf"
    process "BCFTOOLS_CALL"

    tag "modules"
    tag "modules_local"
    tag "bcftools"
    tag "bcftools/call"

    test("test-bcftools-call") {
        config './nextflow.config'

        setup {
            run("BCFTOOLS_MPILEUP") {
                script "modules/local/bcftools/mpileup/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        [],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ]
                    input[1] = [
                        [ id:'ref' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                    ]
                    input[2] = false
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = BCFTOOLS_MPILEUP.out.vcf.map { meta, vcf_file ->
                            tuple(meta, vcf_file, [])
                        }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.tbi,
                    file(process.out.vcf.get(0).get(1)).name,
                    process.out.versions_bcftools
                  ).match()
                }
            )
        }
    }
}
